# FOC requires 1 kHz FreeRTOS tick (esp_simplefoc requirement)
CONFIG_FREERTOS_HZ=1000

# ESP32-S3 at full speed for FOC loop
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# T-Display-S3: 16MB flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Console on native USB-Serial-JTAG (T-Display-S3 的 USB-C 口)。
# 旧配置 UART0 时日志能看到（secondary 输出），但 knob> 无法输入命令。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
